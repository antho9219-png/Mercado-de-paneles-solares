# Entornos y cachés
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Entorno definido por el usuario (no subir credenciales/datos locales)
.env

# Salidas generadas
logs/
output/

# Datos recopilados: se evita publicar grandes volúmenes de datos.
# Los directorios se conservan con un .gitkeep, pero su contenido no se sube.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Los datos de EJEMPLO (pequeños y claramente etiquetados) sí se versionan.
!data/examples/
!data/ejemplo_anuncios.csv
!data/ejemplo_anuncios.json

# Archivos temporales
*.tmp
*.bak

# Datos reales de terceros: se conservan localmente, pero NO se publican en Git.
# (Condiciona el uso de Revolico: no se redistribuyen anuncios de terceros.)
revolico.json
paneles_solares_completo.json
scrape_revolco_ia_full.py

# Backups de trabajo
entrevistas.json.backup.*
entrevistas.json.conflict-backup.*
entrevistas_respaldo.*
*.backup.*
 

# Telegram
*.session
*.session-journal
.env.telegram
test_telegram_connection.py

