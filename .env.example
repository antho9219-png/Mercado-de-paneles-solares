# Copia este archivo a .env (o expórtalo en tu shell) y ajusta los valores.
# El programa lee estas variables de entorno; los valores por defecto son seguros.

# --- Cortesía con el sitio (no sobrecargar) ---
REQUEST_DELAY=3.0
REQUEST_TIMEOUT=20.0
MAX_RETRIES=3
MAX_PAGES=3
PAGE_LENGTH=50
MAX_ITEMS=50            # máximo de anuncios por ejecución
FETCH_DETAILS=true
MAX_DETAILS=20
RESPECT_ROBOTS=true

# --- Ámbito geográfico ---
PROVINCE=La Habana

# --- Autorización del scraper (DESACTIVADO por defecto) ---
# Actívalo SOLO si cuentas con autorización / base legítima verificada.
SCRAPER_ENABLED=false
AUTHORIZATION_CONFIRMED=false

# --- Identificación honesta del cliente HTTP ---
USER_AGENT=SolarMarketResearchBot/1.0 (+contacto: estudiante@ejemplo.com)

# --- Rutas y registro ---
OUT_DIR=output
DATA_DIR=data
LOG_DIR=logs
RAW_CSV_NAME=paneles_solares_habana.csv
PROCESSED_CSV_NAME=paneles_solares_habana_limpio.csv
LOG_LEVEL=INFO

# --- Búsqueda (separados por comas) ---
# SEARCH_TERMS=panel solar,paneles solares,sistema fotovoltaico,kit solar,inversor solar,batería solar
